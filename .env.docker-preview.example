# Local Docker builds + static preview; see docs/zh-CN/local-docker-preview.md.
# Copy/merge into untracked apps/api/.env; never commit real credentials.
# Replace database placeholders with a dedicated local development database.
DATABASE_URL=mysql://replace_me:replace_me@127.0.0.1:3306/replace_me
REDIS_URL=redis://127.0.0.1:36379/0
PORT=3001
API_HOST=127.0.0.1
CONSOLE_ORIGIN=http://127.0.0.1:5173

# Console build/preview writes require OIDC + project Owner/Editor permissions.
# Local Keycloak preset from docs/zh-CN/keycloak-development.md (no client secret).
# Configure apps/console/.env.local separately as described there.
AUTH_MODE=oidc
OIDC_ISSUER=http://127.0.0.1:18080/realms/forgekit-dev
OIDC_JWKS_URL=http://127.0.0.1:18080/realms/forgekit-dev/protocol/openid-connect/certs
OIDC_API_AUDIENCE=forgekit-api
OIDC_DEV_ALLOW_HTTP_LOOPBACK=true

FORGEKIT_BUILD_RUNNER=docker
# Required in Docker mode; absolute, durable paths outside the repository, mode 0700.
# API, Worker and preview must use the same artifact directory.
FORGEKIT_ARTIFACT_DIR=/srv/forgekit/artifacts
FORGEKIT_BUILD_WORKSPACE_DIR=/srv/forgekit/work
# Pre-pull this image using the Worker's Docker daemon; runner uses --pull=never.
FORGEKIT_BUILD_IMAGE=node:22
# Local/dev only: install scripts can exfiltrate data or probe reachable networks.
# Production must use restricted registry egress or none; builds always use none.
FORGEKIT_BUILD_INSTALL_NETWORK=outbound

# API and the separate preview process must use matching preview configuration.
FORGEKIT_PREVIEW_BASE_URL=http://preview.localhost:3002
FORGEKIT_PREVIEW_HOST=127.0.0.1
FORGEKIT_PREVIEW_PORT=3002

# Optional settings already documented in .env.example.
# WORKER_CONCURRENCY=2
# BUILD_TIMEOUT_MS=600000
# WORKER_HEARTBEAT_MS=30000
# FORGEKIT_BUILD_RUNTIME=runsc
# Registry mode requires an operator-managed isolated network + restricted proxy.
# FORGEKIT_BUILD_INSTALL_NETWORK=registry
# FORGEKIT_BUILD_REGISTRY_NETWORK=forgekit-registry
# FORGEKIT_BUILD_REGISTRY_PROXY=http://registry-proxy:3128
