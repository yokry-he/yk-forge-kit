# Local development: the API also uses AUTH_MODE=local.
VITE_AUTH_MODE=local

# OIDC mode: register this public SPA client and its redirect/logout URLs with the IdP.
# VITE_AUTH_MODE=oidc
# VITE_OIDC_AUTHORITY=https://idp.example.com/realms/forgekit
# VITE_OIDC_CLIENT_ID=forgekit-web
# Optional, provider-specific RFC 8707 resource indicator for API audience:
# VITE_OIDC_RESOURCE=forgekit-api
