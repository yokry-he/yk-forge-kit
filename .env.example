# Copy to an untracked .env file for local development; do not commit real credentials.
# Host address depends on whether the API runs on the host or in another Docker container.
DATABASE_URL=mysql://forgekit_user:replace_me@127.0.0.1:3306/forgekit
PORT=3001
API_HOST=127.0.0.1
AUTH_MODE=local
CONSOLE_ORIGIN=http://localhost:5173

# Optional for API startup; required to trigger builds and start the worker.
REDIS_URL=redis://127.0.0.1:36379/0
WORKER_CONCURRENCY=2
BUILD_TIMEOUT_MS=600000
WORKER_HEARTBEAT_MS=30000

# B09: noop is safe for default development/tests. Docker requires a dedicated host.
FORGEKIT_BUILD_RUNNER=noop
# FORGEKIT_ARTIFACT_DIR=/srv/forgekit/artifacts
# FORGEKIT_BUILD_WORKSPACE_DIR=/srv/forgekit/work
# FORGEKIT_BUILD_IMAGE=node:22
# FORGEKIT_BUILD_RUNTIME=runsc
# Install defaults to none; outbound is only for isolated development/CI.
# FORGEKIT_BUILD_INSTALL_NETWORK=registry
# FORGEKIT_BUILD_REGISTRY_NETWORK=forgekit-registry
# FORGEKIT_BUILD_REGISTRY_PROXY=http://registry-proxy:3128

# B11: separate preview process; wildcard *.preview.localhost must resolve to loopback.
# Start with pnpm --filter @forgekit/api preview:dev (configure artifact dir above).
# FORGEKIT_PREVIEW_BASE_URL=http://preview.localhost:3002
# FORGEKIT_PREVIEW_HOST=127.0.0.1
# FORGEKIT_PREVIEW_PORT=3002
# Production requires HTTPS, a separate registrable domain and explicit control-plane origins.
# FORGEKIT_API_BASE_URL=https://api.example.com
